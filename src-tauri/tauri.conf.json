{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RefThing",
  "version": "0.3.1",
  "identifier": "com.refthing.app",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build -w frontend",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../frontend/dist": "dist",
      "icons/ref-file.ico": "ref-file.ico"
    },
    "createUpdaterArtifacts": true,
    "publisher": "RefThing",
    "shortDescription": "A fast reference board",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "fileAssociations": [
      {
        "ext": ["ref"],
        "name": "RefThing board",
        "description": "RefThing reference board",
        "role": "Editor",
        "mimeType": "application/x-refthing-board"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk2RURBNEQ1NDE4NzFDQjMKUldTekhJZEIxYVR0bHE2NmhXT3J3bkR1Njk4cWZOUms5bnlwcmxXSTh4dFNPei9qbUZUY2hrK1kK",
      "endpoints": ["https://github.com/POYZINIS/RefThing/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
