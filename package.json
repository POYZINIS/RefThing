{
  "name": "refthing",
  "private": true,
  "workspaces": [
    "frontend",
    "sidecar"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "cargo run --manifest-path backend/Cargo.toml -p refthing-server",
    "dev:api:once": "cargo run --manifest-path backend/Cargo.toml -p refthing-server",
    "dev:web": "npm run dev -w frontend",
    "lint": "biome check . && cargo clippy --manifest-path backend/Cargo.toml --workspace --all-targets",
    "fmt": "biome check --write . && cargo fmt --manifest-path backend/Cargo.toml --all",
    "typecheck": "npm run typecheck -w frontend"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "concurrently": "^9"
  }
}
